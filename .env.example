# ── Site ────────────────────────────────────────────────────────────────────
# Canonical production URL (no trailing slash). Used for metadata, sitemap,
# robots, RSS, canonical URLs and JSON-LD. On Vercel previews it is safe to
# leave unset — the app falls back to a sensible default.
NEXT_PUBLIC_SITE_URL=https://umberleaf.com

# ── Firebase (Web app config — all values are public by design) ─────────────
# Firebase console → Project settings → Your apps → SDK setup and configuration.
# Security comes from Firestore rules, NOT from hiding these values.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Optional — enables Firebase Analytics (GA4). Leave empty to disable cleanly.
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=
